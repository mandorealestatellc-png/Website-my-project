# Copy this file to .env.local and fill in your values

# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend — get from resend.com
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL=armando@youremail.com

# Admin dashboard password (client-side check — also set on Vercel)
NEXT_PUBLIC_ADMIN_PASSWORD=change_this_to_a_strong_password
